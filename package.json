    "web": "expo start --web",
    "tipos": "tsc --noEmit",
    "lint": "expo lint",
    "formato": "prettier --write .",
    "formato:revisar": "prettier --check .",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",

{
  "name": "brote_mobile_expo",
  "version": "0.1.0",
  "description": "App móvil de Brote: cursar cursos interactivos, también sin conexión",
  "private": true,
  "license": "MIT",
  "author": "BroteCodigoAbierto",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
